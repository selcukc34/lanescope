node_modules/
dist/
out/
coverage/
.DS_Store

# Personal agent settings
CLAUDE.local.md

# BAW exports never go to the repo.
# They can embed customer processes and IBM toolkit content. Keep them on the
# developer machine under test/fixtures/local/; tests that need them are
# skipped when the folder is empty.
*.twx
*.twx.*
test/fixtures/twx/
test/fixtures/local/

# Descriptions written next to fixtures while testing (New or Open Process
# Description). The one committed description is Bob's input for the Order
# Delivery Process.
test/fixtures/**/*-description.md
!test/fixtures/bob/order-delivery-process-description.md

# Build and test output
*.vsix
test/output/

# CI test report
test-results.json
